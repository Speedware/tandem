<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package Name="Tandem"
           Manufacturer="Tandem"
           Version="$(var.AppVersion)"
           UpgradeCode="5B0C8E7A-3D1F-4C6B-9E2A-7F4D1B8C3A90"
           Scope="perMachine"
           Language="1049"
           Codepage="1251"
           Compressed="yes">

    <SummaryInformation Description="Tandem — зеркало окна на второй монитор" Manufacturer="Tandem" />

    <MajorUpgrade DowngradeErrorMessage="Уже установлена более новая версия Tandem." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="AppIcon" SourceFile="$(var.IconFile)" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="DESKTOP_SHORTCUT" Value="1" Secure="yes" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Tandem" />
    </StandardDirectory>

    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="$(var.StageDir)\**" />
    </ComponentGroup>

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut">
        <Shortcut Id="StartMenuShortcut" Name="Tandem" Description="Зеркало окна на второй монитор"
                  Target="[INSTALLFOLDER]python\pythonw.exe"
                  Arguments="&quot;[INSTALLFOLDER]app\main.py&quot;"
                  WorkingDirectory="INSTALLFOLDER" Icon="AppIcon">
          <ShortcutProperty Key="System.AppUserModel.ID" Value="Tandem.App" />
        </Shortcut>
        <RegistryValue Root="HKMU" Key="Software\Tandem" Name="StartMenuShortcut"
                       Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder">
      <Component Id="DesktopShortcut" Condition="DESKTOP_SHORTCUT = 1">
        <Shortcut Id="DesktopShortcut" Name="Tandem" Description="Зеркало окна на второй монитор"
                  Target="[INSTALLFOLDER]python\pythonw.exe"
                  Arguments="&quot;[INSTALLFOLDER]app\main.py&quot;"
                  WorkingDirectory="INSTALLFOLDER" Icon="AppIcon">
          <ShortcutProperty Key="System.AppUserModel.ID" Value="Tandem.App" />
        </Shortcut>
        <RegistryValue Root="HKMU" Key="Software\Tandem" Name="DesktopShortcut"
                       Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <Feature Id="Main" Title="Tandem">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DesktopShortcut" />
    </Feature>

    <CustomAction Id="StopApp" Directory="INSTALLFOLDER" Return="ignore"
                  ExeCommand="&quot;[INSTALLFOLDER]python\pythonw.exe&quot; &quot;[INSTALLFOLDER]app\main.py&quot; --quit" />
    <CustomAction Id="CleanupApp" Directory="INSTALLFOLDER" Return="ignore"
                  ExeCommand="&quot;[INSTALLFOLDER]python\pythonw.exe&quot; &quot;[INSTALLFOLDER]app\main.py&quot; --uninstall" />
    <CustomAction Id="LaunchApp" Directory="INSTALLFOLDER" Return="asyncNoWait"
                  ExeCommand="&quot;[INSTALLFOLDER]python\pythonw.exe&quot; &quot;[INSTALLFOLDER]app\main.py&quot;" />

    <InstallExecuteSequence>
      <Custom Action="StopApp" Before="InstallValidate" Condition="NOT (REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE)" />
      <Custom Action="CleanupApp" Before="InstallValidate" Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>

    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <UI>
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" Order="99" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="99" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchApp"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
    </UI>
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Запустить Tandem" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
  </Package>
</Wix>
